# Copie este arquivo para .env e ajuste os valores
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# Endereço(s) do front-end Angular, separados por vírgula
CORS_ORIGIN=http://localhost:4200
LOG_LEVEL=info
# Chave que assina os tokens. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRACAO_PROFESSOR=8h
JWT_EXPIRACAO_ALUNO=4h

# Professor criado ao subir o servidor (somente enquanto usamos o banco em memória)
PROFESSOR_INICIAL_NOME=Professor
PROFESSOR_INICIAL_EMAIL=professor@codebuddies.com
PROFESSOR_INICIAL_SENHA=troque-esta-senha